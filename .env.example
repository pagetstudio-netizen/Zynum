# ─────────────────────────────────────────────
#  ZyNum — Variables d'environnement (Plesk / Production)
#  Copier ce fichier en .env et remplir les valeurs réelles
# ─────────────────────────────────────────────

# Serveur
PORT=3000
NODE_ENV=production
API_BASE_URL=https://zynum.net

# ── Base de données ───────────────────────────
# Supabase Transaction Pooler (port 6543)
SUPABASE_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── 5SIM (numéros virtuels) ───────────────────
FIVESIM_API_KEY=your_fivesim_api_key_here

# ── Emails (Resend) ───────────────────────────
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=ZyNum <noreply@zynum.net>

# ── Notifications Telegram (admin) ────────────
TELEGRAM_BOT_TOKEN=123456789:AAF-your_telegram_bot_token
TELEGRAM_CHAT_ID=-1001234567890

# ── Paiement OmniPay ──────────────────────────
OMNIPAY_API_KEY=omnipay_api_key_xxxxxxxxxxxx
OMNIPAY_CALLBACK_KEY=omnipay_ck_xxxxxxxxxxxx

# ── Paiement SendavaPay ───────────────────────
SENDAVAPAY_SDK_KEY=sdk_xxxxxxxxxxxx
SENDAVAPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ── Paiement Paxity ───────────────────────────
PAXITY_APP_TOKEN=eyJ...your_paxity_app_token
PAXITY_API_KEY=private_xxxxxxxxxxxx
PAXITY_API_TOKEN=xxxxxxxxxxxx

# ── Paiement AshtechPay ───────────────────────
ASHTECHPAY_API_KEY=your_ashtechpay_api_key

# ── SMTP (nodemailer fallback) ────────────────
SMTP_FROM_PASSWORD=your_smtp_password
