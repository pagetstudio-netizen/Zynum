PORT=3000
NODE_ENV=production

# Supabase (Transaction Pooler)
SUPABASE_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# 5SIM
FIVESIM_API_KEY=your_fivesim_api_key_here

# Session
SESSION_SECRET=your_random_secret_here_min_32_chars

# Resend (emails)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=ZyNum <noreply@zynum.net>

# Telegram Bot (notifications admin)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
TELEGRAM_CHAT_ID=-1001234567890
