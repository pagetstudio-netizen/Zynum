{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "NODE_ENV=production pnpm --filter @workspace/zynum run build && NODE_ENV=production pnpm --filter @workspace/api-server run build",
    "start": "NODE_ENV=production node app.js",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "@remix-run/router": "1.23.3",
      "axios": "1.18.0",
      "body-parser": "2.3.0",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "browserslist": "4.28.7",
      "fast-uri": "3.1.6",
      "form-data": "4.0.6",
      "immutable": "5.1.8",
      "js-yaml": "4.3.2",
      "linkify-it": "5.0.2",
      "lodash": "4.18.0",
      "lodash-es": "4.18.0",
      "nanoid": "3.3.18",
      "path-to-regexp": "8.4.0",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.4",
      "postcss": "8.5.23",
      "qs": "6.16.0",
      "react-router": "6.30.6",
      "react-router-dom": "6.30.6",
      "socket.io-parser": "4.2.7",
      "undici": "7.29.0",
      "uuid": "11.1.1",
      "websocket-driver@0.7.4": "0.7.5",
      "ws": "8.21.0",
      "@scalar/openapi-parser>yaml": "2.9.0",
      "@scalar/openapi-validator>yaml": "2.9.0",
      "@scalar/json-schema-validator>yaml": "2.9.0",
      "@scalar/json-magic>yaml": "2.9.0",
      "yaml": "1.10.3"
    }
  }
}
